diff --git a/source/i18n/number_formatimpl.cpp b/source/i18n/number_formatimpl.cpp
index 45baa9461..937df9b48 100644
--- a/source/i18n/number_formatimpl.cpp
+++ b/source/i18n/number_formatimpl.cpp
@@ -168,16 +168,29 @@ NumberFormatterImpl::macrosToMicroGenerator(const MacroProps& macros, bool safe,
 
     // Select the numbering system.
     LocalPointer<const NumberingSystem> nsLocal;
-    const NumberingSystem* ns;
+    const NumberingSystem* ns = nullptr;
+    const char* nsName = nullptr;
     if (macros.symbols.isNumberingSystem()) {
         ns = macros.symbols.getNumberingSystem();
+    } else if (macros.symbols.isDecimalFormatSymbols() &&
+               macros.symbols.getDecimalFormatSymbols()->getLocale() ==
+                   macros.locale &&
+               macros.symbols.getDecimalFormatSymbols()
+                       ->getNumberingSystemName()[0] != '\0') {
+        // Reuse the numbering system name already resolved on the
+        // DecimalFormatSymbols when its locale matches `macros.locale`,
+        // avoiding a redundant `NumberingSystem::createInstance()` lookup.
+        nsName =
+            macros.symbols.getDecimalFormatSymbols()->getNumberingSystemName();
     } else {
         // TODO: Is there a way to avoid creating the NumberingSystem object?
         ns = NumberingSystem::createInstance(macros.locale, status);
         // Give ownership to the function scope.
         nsLocal.adoptInstead(ns);
     }
-    const char* nsName = U_SUCCESS(status) ? ns->getName() : "latn";
+    if (nsName == nullptr) {
+        nsName = (U_SUCCESS(status) && ns != nullptr) ? ns->getName() : "latn";
+    }
     uprv_strncpy(fMicros.nsName, nsName, 8);
     fMicros.nsName[8] = 0; // guarantee NUL-terminated
 
diff --git a/source/i18n/numfmt.cpp b/source/i18n/numfmt.cpp
index 7c877a33a..863be4957 100644
--- a/source/i18n/numfmt.cpp
+++ b/source/i18n/numfmt.cpp
@@ -1405,8 +1405,10 @@ NumberFormat::makeInstance(const Locale& desiredLocale,
         return nullptr;
     }
     else {
-        // Loads the decimal symbols of the desired locale.
-        symbolsToAdopt.adoptInsteadAndCheckErrorCode(new DecimalFormatSymbols(desiredLocale, status), status);
+        // Loads the decimal symbols of the desired locale. Pass `*ns` to avoid
+        // a redundant uncached `NumberingSystem::createInstance()` lookup.
+        symbolsToAdopt.adoptInsteadAndCheckErrorCode(
+            new DecimalFormatSymbols(desiredLocale, *ns, status), status);
         if (U_FAILURE(status)) {
             return nullptr;
         }
