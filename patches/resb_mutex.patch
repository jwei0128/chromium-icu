+namespace {
+
+// Collects entries in top-down order (from the opened child entry down to
+// `root` or the first ancestor that already has `fParent != nullptr`) while
+// loading parents in `entryOpen()` and `entryOpenDirect()`.
+//
+// Because `init_entry()` releases `resbMutex` during `res_load()`, linking
+// `child->fParent = parent` top-down as each parent loads would expose a
+// partially linked chain in `cache` while `resbMutex` is unlocked for the next
+// ancestor's `res_load()` (causing a concurrent `entryOpen()` finding `child`
+// in `cache` to see `child->fParent != nullptr` and stop before `root` is
+// linked).
+//
+// Linking `fParent` bottom-up under `resbMutex` after all `init_entry()` calls
+// finish guarantees that any entry in `cache` with `fParent != nullptr` already
+// has its complete, immutable ancestor chain up to `root`.
+struct ParentChain {
+    UResourceDataEntry *entries[ULOC_FULLNAME_CAPACITY];
+    int32_t length = 0;
+
+    void push(UResourceDataEntry *entry) {
+        U_ASSERT(length < ULOC_FULLNAME_CAPACITY);
+        entries[length++] = entry;
+    }
+
+    void linkBottomUp(UResourceDataEntry *&t1) {
+        if (length == 0) {
+            return;
+        }
+        // Find the highest entry in `entries` that was already linked to a
+        // parent (either before this call or by another thread while
+        // `resbMutex` was unlocked during `res_load()`).
+        int32_t firstLinked = length - 1;
+        for (int32_t i = 0; i < length - 1; ++i) {
+            if (entries[i]->fParent.load(std::memory_order_relaxed) != nullptr) {
+                firstLinked = i;
+                break;
+            }
+        }
+        // Link `entries[0 .. firstLinked - 1]` bottom-up to
+        // `entries[firstLinked]`.
+        for (int32_t i = firstLinked - 1; i >= 0; --i) {
+            entries[i]->fParent.store(entries[i + 1], std::memory_order_release);
+        }
+        // Any entries after `firstLinked` were loaded speculatively before
+        // `entries[firstLinked]->fParent` was linked by another thread;
+        // release their reference counts and let the caller's post-loop
+        // increment the existing `entries[firstLinked]->fParent` chain.
+        for (int32_t i = firstLinked + 1; i < length; ++i) {
+            entries[i]->fCountExisting--;
+        }
+        t1 = entries[firstLinked];
+    }
+};
+
